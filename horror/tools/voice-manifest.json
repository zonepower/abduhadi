 },
 {
  "who": "shepherd",
  "text": "كفى لعباً!",
  "emo": "angry"
 },
 {
  "who": "karim",
  "text": "نعم. كفى.",
  "emo": "cold"
 },
 {
  "who": "shepherd",
  "text": "هذا البيت… لن يدعك تخرج…",
  "emo": "hurt"
 },
 {
  "who": "shepherd",
  "text": "لن يدعك…",
  "emo": "hurt"
 },
 {
  "who": "karim",
  "text": "لا يهم.",
  "emo": "soft"
 },
 {
  "who": "karim",
  "text": "لم أعد أريد الخروج.",
  "emo": "cry"
 },
 {
  "who": "narrator",
  "text": "خرج كريم من البيت عند الفجر، وابنته بين ذراعيه.",
  "emo": "soft"
 },
 {
  "who": "narrator",
  "text": "لم يخبر أحداً بما رآه. ولم يعد أحدٌ يسمع صوت ضحكٍ في ذلك الطريق.",
  "emo": "soft"
 },
 {
  "who": "narrator",
  "text": "لكن في كل ليلة مطر… يقف على الطريق، وينتظر أن يضيع أحدهم.",
  "emo": "cold"
 },
 {
  "who": "karim",
  "text": "انتهى الأمر.",
  "emo": "cry"
 },
 {
  "who": "karim",
  "text": "نامي الآن.",
  "emo": "cry"
 },
 {
  "who": "narrator",
  "text": "في ليلة مطرٍ لا ينتهي، تعطّلت سيارةٌ على طريقٍ لا يمرّ به أحد.",
  "emo": "soft"
 },
 {
  "who": "karim",
  "text": "حسناً… المحرك مات تماماً.",
  "emo": "tense"
 },
 {
  "who": "layla",
  "text": "بابا، أين نحن؟",
  "emo": "afraid"
 },
 {
  "who": "karim",
  "text": "لا أعرف يا حبيبتي. لكن هناك بيت. سنطلب المساعدة ونعود.",
  "emo": "soft"
 },
 {
  "who": "layla",
  "text": "البيت مظلم. لا أحد فيه.",
  "emo": "afraid"
 },
 {
  "who": "karim",
  "text": "ابقي خلفي وامسكي يدي. لن يحدث لكِ شيء. أعدكِ.",
  "emo": "soft"
 },
 {
  "who": "shepherd",
  "text": "أهلاً بك في بيتي يا كريم.",
  "emo": "cold"
 },
 {
  "who": "karim",
  "text": "من أنت؟! كيف تعرف اسمي؟",
  "emo": "afraid"
 },
 {
  "who": "shepherd",
  "text": "أنا أعرف كل من يدخل… وكل من لا يخرج.",
  "emo": "cold"
 },
 {
  "who": "shepherd",
  "text": "وأشكرك. لقد أحضرتَ لي هديّةً صغيرة.",
  "emo": "mock"
 },
 {
  "who": "karim",
  "text": "ابتعد عنها! هل تسمعني؟! ابتعد عنها!",
  "emo": "scream"
 },
 {
  "who": "layla",
  "text": "باباااا!",
  "emo": "scream"
 },
 {
  "who": "karim",
  "text": "ليلى؟! ليلى!! لا!",
  "emo": "scream"
 },
 {
  "who": "shepherd",
  "text": "قلتُ لك أن تخرج وحدك. الآن ستخرج وحدك فعلاً.",
  "emo": "mock"
 },
 {
  "who": "karim",
  "text": "سآتي إليك. أقسم بالله سآتي إليك.",
  "emo": "angry"
 },
 {
  "who": "shepherd",
  "text": "هههههههه.",
  "emo": "mock"
 },
 {
  "who": "shepherd",
  "text": "ما زلتَ حيّاً؟ كم هذا مؤسف.",
  "emo": "mock"
 },
 {
  "who": "shepherd",
  "text": "اركض. الركض يجعل الأمر أطول.",
  "emo": "mock"
 },
 {
  "who": "shepherd",
  "text": "هل تسمع؟ إنها تناديك.",
  "emo": "mock"
 },
 {
